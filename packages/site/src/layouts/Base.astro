---
// Page shell: head, the header with the logo, and the stylesheet.
import '../styles/site.css';
import iconUrl from '@blook/ui/icon.svg?url';
import { STORE_URL } from '../links';
import shareImage from '../../../store/images/screenshot-1-timeline.png';

interface Props {
  title: string;
  description: string;
  /** The viewer fills the window, so it gets no header. */
  bare?: boolean;
}
const { title, description, bare } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const url = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<!-- overflow-x-clip, not hidden: a wide line never scrolls the page sideways, and sticky still works. -->
<html lang="en" class="overflow-x-clip">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(shareImage.src, Astro.site)} />
    <meta property="og:image:width" content={String(shareImage.width)} />
    <meta property="og:image:height" content={String(shareImage.height)} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={url} />
    <link rel="icon" type="image/svg+xml" href={iconUrl} />
  </head>
  <body class="overflow-x-clip bg-surface text-fg antialiased">
    {
      !bare && (
        <header class="border-b border-line">
          <nav class="mx-auto flex h-14 max-w-5xl items-center gap-4 px-5 text-sm whitespace-nowrap sm:gap-5">
            <a href={base} class="mr-auto flex items-center gap-2 font-semibold">
              <img src={iconUrl} alt="" width="22" height="22" />
              Blook
            </a>
            <a href={`${base}viewer/`} class="rounded-control hover:underline">Viewer</a>
            <a href={STORE_URL} class="rounded-control hover:underline">Chrome Web Store</a>
            <a href="https://github.com/cyrillbrito/blook" class="rounded-control hover:underline">GitHub</a>
          </nav>
        </header>
      )
    }
    <slot />
  </body>
</html>
