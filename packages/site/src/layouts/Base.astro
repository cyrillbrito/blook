---
// Page shell: head, the header with the logo, and the stylesheet.
import '../styles/site.css';
import iconUrl from '@blook/ui/icon.svg?url';

interface Props {
  title: string;
  description: string;
  /** The viewer fills the window, so it gets no header. */
  bare?: boolean;
}
const { title, description, bare } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="icon" type="image/svg+xml" href={iconUrl} />
  </head>
  <body class="bg-surface text-fg antialiased">
    {
      !bare && (
        <header class="border-b border-line">
          <nav class="mx-auto flex h-14 max-w-5xl items-center gap-5 px-5 text-sm">
            <a href={base} class="mr-auto flex items-center gap-2 font-semibold">
              <img src={iconUrl} alt="" width="22" height="22" />
              Blook
            </a>
            <a href={`${base}viewer/`} class="rounded-control hover:underline focus-visible:ring-2 focus-visible:ring-accent/50 focus-visible:outline-none">Viewer</a>
            <a href="https://github.com/cyrillbrito/blook" class="rounded-control hover:underline focus-visible:ring-2 focus-visible:ring-accent/50 focus-visible:outline-none">GitHub</a>
          </nav>
        </header>
      )
    }
    <slot />
  </body>
</html>
