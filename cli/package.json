{
  "name": "blook",
  "private": true,
  "version": "0.1.0",
  "description": "Replay a Blook bundle at time T: screenshot, DOM, pointer",
  "type": "module",
  "bin": {
    "blook": "./src/cli.ts"
  },
  "scripts": {
    "replay": "node src/cli.ts",
    "replay:bun": "bun src/cli.ts",
    "build:bin": "bun build --compile --minify src/cli.ts --external chromium-bidi --external 'chromium-bidi/*' --outfile dist/blook",
    "compile": "tsc --noEmit"
  },
  "dependencies": {
    "@rrweb/replay": "^2.2.0",
    "fflate": "^0.8.3",
    "playwright-core": "^1.64.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "~6.0.3"
  }
}
