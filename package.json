{
  "name": "blook",
  "version": "0.5.0",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "@rrweb/record": "^2.2.2",
      "@rrweb/replay": "^2.2.2",
      "@rrweb/types": "^2.2.2",
      "@tailwindcss/vite": "^4.3.5",
      "@types/bun": "^1.4.5",
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0",
      "fflate": "^0.8.3",
      "lucide-react": "^1.78.0",
      "react": "^19.3.1",
      "react-dom": "^19.3.1",
      "tailwindcss": "^4.3.5"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "bun --cwd=packages/extension run dev",
    "build": "bun run --workspaces --if-present build",
    "zip": "bun --cwd=packages/extension run zip",
    "typecheck": "bun run --workspaces --if-present typecheck",
    "test": "bun run --workspaces --if-present test",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "devDependencies": {
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "typescript": "~7.0.2"
  }
}
