{
  "name": "blook",
  "version": "0.3.0",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "@rrweb/record": "^2.2.0",
      "@rrweb/replay": "^2.2.0",
      "@rrweb/types": "^2.2.0",
      "@tailwindcss/vite": "^4.3.4",
      "@types/bun": "^1.4.4",
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0",
      "fflate": "^0.8.3",
      "react": "^19.3.1",
      "react-dom": "^19.3.1",
      "tailwindcss": "^4.3.4"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "bun --cwd=packages/extension run dev",
    "build": "bun run --workspaces --if-present build",
    "zip": "bun --cwd=packages/extension run zip",
    "typecheck": "bun check -p packages/core && bun check -p packages/ui && bun check -p packages/viewer && bun check -p packages/extension && bun check -p packages/cli && bun check -p packages/site",
    "test": "bun run --workspaces --if-present test",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "devDependencies": {
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "typescript": "~7.0.2"
  }
}
